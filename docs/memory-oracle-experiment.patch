diff --git a/test/helpers/run-leak-probe.ts b/test/helpers/run-leak-probe.ts
new file mode 100644
index 0000000..a5f6076
--- /dev/null
+++ b/test/helpers/run-leak-probe.ts
@@ -0,0 +1,27 @@
+import { join } from "node:path";
+import * as v from "valibot";
+
+const probeSchema = v.object({
+  scenario: v.string(),
+  slopeKbPerIter: v.number(),
+  twoPointKbPerIter: v.number(),
+  samples: v.number(),
+  iterations: v.number(),
+  rssEndMb: v.number(),
+});
+
+export async function runProbe(scenario: string): Promise<v.InferOutput<typeof probeSchema>> {
+  const proc = Bun.spawn(["bun", join(import.meta.dir, "leak-probe.ts"), scenario], { stdout: "pipe", stderr: "pipe" });
+  const [stdout, stderr, exitCode] = await Promise.all([new Response(proc.stdout).text(), new Response(proc.stderr).text(), proc.exited]);
+
+  if (exitCode !== 0) throw new Error(`leak-probe ${scenario} exited ${exitCode}: ${stderr}`);
+
+  const lastLine = stdout.trim().split("\n").at(-1) ?? "";
+  const result = v.parse(probeSchema, JSON.parse(lastLine));
+  console.log(
+    `  ${scenario}: slope ${result.slopeKbPerIter.toFixed(2)} KB/iter over ${result.samples} samples ` +
+      `(two-point: ${result.twoPointKbPerIter.toFixed(2)} KB/iter, rss end ${result.rssEndMb.toFixed(1)} MB)`,
+  );
+
+  return result;
+}
