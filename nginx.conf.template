daemon off;
worker_processes auto;
error_log /dev/stderr warn;
pid /run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    charset utf-8;
    charset_types text/xml application/xml application/atom+xml;

    access_log /dev/stdout;

    sendfile on;
    tcp_nopush on;

    # ETag enabled by default

    # Convert a catalogue feed URI to its filesystem directory for the
    # initializing discriminator. A missing directory must remain a steady
    # state 404 once the root feed exists.
    map $uri $catalog_data_path {
        default /__not_a_catalog_directory__;
        ~^/_catalog(?<catalog_path>/.*)/feed\.xml$ $catalog_path;
    }

    server {
        listen 80;
        server_name _;

        # Use relative redirects (no host prefix)
        absolute_redirect off;

        # /opds serves the root feed directly (200 XML), no 302: strict OPDS
        # readers reject the redirect's text/html body with "incorrect content".
        location = /opds {
            root /data;
            try_files /feed.xml =404;
            add_header Cache-Control "no-cache";
            error_page 404 = @check_initializing;
        }

        location = /opds/ {
            root /data;
            try_files /feed.xml =404;
            add_header Cache-Control "no-cache";
            error_page 404 = @check_initializing;
        }

        # Static assets from /_app folder
        # ^~ so the .xml/image regex locations below cannot capture /_app/* into /data
        # no-cache (ETag revalidation): unversioned reader.js and favicons remain here.
        # The shell's CSS and main.js use the immutable hashed location below.
        location = /_app/ {
            return 404;
        }

        location = /_app/index.html {
            return 404;
        }

        location ^~ /_app/ {
            alias /app/static/;
            add_header Cache-Control "no-cache";
        }

        # Hashed shell assets: the filename matches the content, so forever-caching
        # is safe and a new deploy gets a new URL.
        location ^~ /_app/assets/ {
            alias /app/static/assets/;
            types {
                application/javascript js;
                text/css css;
            }
            default_type application/octet-stream;
            add_header Cache-Control "public, max-age=31536000, immutable";
        }

        # Reader page: deny-by-default CSP (KTD-6), pinned verbatim by the e2e test.
        # This is the load-bearing script control for book content: foliate's blob:
        # iframes inherit it, and its own iframe sandbox provides no isolation
        # (allow-same-origin + allow-scripts, WebKit bug 218086). Never widen it and
        # never add 'unsafe-eval'. Exact match beats the ^~ /_app/ prefix above.
        # add_header REPLACES inherited headers, so no-cache must be re-declared here
        # or read.html ships with no Cache-Control and the stale-asset bug (see the
        # comment on /_app/ above) returns.
        location = /_app/read.html {
            alias /app/static/read.html;
            add_header Cache-Control "no-cache";
            add_header Content-Security-Policy "default-src 'none'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'; connect-src 'self'; worker-src 'self'; frame-src blob:; img-src blob: data:; style-src 'unsafe-inline' blob: data:";
        }

        # Hashed foliate/pdf.js runtime: the directory name is content-hashed and
        # regenerates together with read.html in one build:ui run (KTD-3 lockstep),
        # so forever-caching is safe — unlike the unversioned URLs above.
        # The stock mime.types has no mjs mapping: pdf.mjs would serve as
        # octet-stream and fail the browser's strict module MIME check.
        location ^~ /_app/foliate- {
            alias /app/static/foliate-;
            types {
                application/javascript js mjs;
                text/css css;
            }
            default_type application/octet-stream;
            add_header Cache-Control "public, max-age=31536000, immutable";
        }

        # Admin endpoint: /resync (only if auth configured)
        # AUTH_BLOCK_START
        location = /resync {
            # CSRF guard. proxy_method POST below turns ANY request to /resync into a POST,
            # so a book-frame navigation (meta refresh / window.location) to /resync would
            # fire a real resync using the browser's cached Basic-Auth credentials. The
            # reader CSP already blocks passive subresource hits (img/form/@import → AE6);
            # this closes the navigation gap. The admin tool (curl/wget) sends no
            # Sec-Fetch-* headers and passes; browser navigations and cross-site requests
            # are rejected before the auth challenge (rewrite phase precedes access phase).
            if ($http_sec_fetch_mode = "navigate") { return 403; }
            if ($http_sec_fetch_site = "cross-site") { return 403; }

            auth_basic "OPDS Admin";
            auth_basic_user_file /etc/nginx/.htpasswd;

            proxy_pass http://127.0.0.1:${BUN_PORT}/resync;
            proxy_method POST;
            proxy_set_header Host $host;
        }

        # AUTH_BLOCK_END

        # Bun-local lifecycle endpoints are not public nginx routes.
        location = /events {
            return 404;
        }

        location = /status {
            return 404;
        }

        # Catalogue files from /_catalog. Regex locations use aliases so the route
        # prefix is removed before resolving the path under /data.
        location ~ ^/_catalog/(?<catalog_download_path>.+)/(?<catalog_download_file>[^/]+\.(epub|pdf|mobi|azw|azw3|fb2|fbz|cbz|cbr|cb7|cbt|zip|djvu|txt))$ {
            alias /data/$catalog_download_path/$catalog_download_file;
            add_header Content-Disposition 'attachment; filename="$catalog_download_file"';
            limit_rate ${RATE_LIMIT};
        }

        location ~ ^/_catalog/(?<catalog_image_path>.*\.(jpg|jpeg|png|webp))$ {
            alias /data/$catalog_image_path;
            expires 1d;
            add_header Cache-Control "public, must-revalidate";
        }

        # Feed responses are short-lived cache entries so the browser can reuse
        # shell prefetches during ordinary folder navigation.
        location = /_catalog/feed.xml {
            alias /data/feed.xml;
            add_header Cache-Control "max-age=30";
            error_page 404 = @check_initializing;
        }

        location ~ ^/_catalog/(?<catalog_feed_path>.+)/feed\.xml$ {
            alias /data/$catalog_feed_path/feed.xml;
            add_header Cache-Control "max-age=30";
            error_page 404 = @check_initializing;
        }

        location ~ ^/_catalog/(?<catalog_xml_path>.*\.xml)$ {
            alias /data/$catalog_xml_path;
            add_header Cache-Control "no-cache";
            error_page 404 = @check_initializing;
        }

        location /_catalog/ {
            alias /data/;
            index index.html;
            error_page 404 = @check_initializing;
            error_page 403 = @check_initializing;
        }

        # Every browser path not claimed by an app, catalogue or OPDS location
        # receives the same static shell. Folder navigation uses ordinary links;
        # the shell fetches the matching feed in the browser.
        # The exact root block keeps the root contract explicit; both blocks
        # intentionally serve the same no-cache shell and CSP.
        location = / {
            root /app/static;
            try_files /index.html =404;
            add_header Cache-Control "no-cache";
            add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'";
        }

        location / {
            root /app/static;
            try_files /index.html =404;
            add_header Cache-Control "no-cache";
            add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'";
        }

        location @check_initializing {
            add_header Retry-After 5 always;

            # Book output directories have entry.xml but never publish feed.xml.
            # Their feed URL is a permanent miss, not a folder still being written.
            if (-f /data$catalog_data_path/entry.xml) {
                return 404;
            }

            # A missing catalogue feed is transient while its folder exists.
            if (-d /data$catalog_data_path) {
                return 503;
            }

            # OPDS root and catalogue feeds are transient before the first
            # publication, even when their target directory does not exist yet.
            if (!-f /data/feed.xml) {
                return 503;
            }
            # Steady state and the path genuinely does not exist: a real 404.
            return 404;
        }

        # Custom error pages
        error_page 503 @initializing;
        location @initializing {
            default_type application/json;
            return 503 '{"status":"initializing","message":"Server is starting, please retry later"}';
            add_header Retry-After 5 always;
        }
    }
}
